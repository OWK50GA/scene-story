# Google Cloud
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
GEMINI_API_KEY=

# ClickHouse
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=lmm

# Grafana - Logs
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USERNAME=
GRAFANA_LOKI_TOKEN=

# Grafana - Metrics
GRAFANA_PROMETHEUS_URL=
GRAFANA_PROMETHEUS_USERNAME=
GRAFANA_PROMETHEUS_TOKEN=

# Grafana - MCP
GRAFANA_MCP_TOKEN=
GRAFANA_STACK_URL=

# ClickHouse MCP Server (official mcp-clickhouse Python server)
# Start with: bash scripts/start-mcp-clickhouse.sh
# Docs: https://github.com/ClickHouse/mcp-clickhouse
CLICKHOUSE_MCP_URL=http://localhost:8000/sse
# CLICKHOUSE_MCP_AUTH_TOKEN=   # Set if running MCP server with bearer auth

# Google Cloud Storage (screenplay file retention — GAP-001)
# Create a GCS bucket and set its name here. Leave blank to skip file retention.
GCS_BUCKET=

# App
PORT=3000
NODE_ENV=development